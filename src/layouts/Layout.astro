---
import '@chirag127/oz-tokens-base'
import '@chirag127/oz-chrome/styles.css'
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/inter'
import '../styles/theme.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz color — color studio',
  description = 'Color studio: picker, palette + gradient generator, WCAG contrast checker, extract palette from image, convert hex / rgb / hsl / oklch. 100% in your browser — no upload, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a56ff" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Color" />
    <script is:inline src="/registerSW.js"></script>
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <OzToolShell site="color" title="color studio" themeColor="#1a56ff">
      <slot />
      <Fragment slot="footer">
        <a href="https://github.com/chirag127/oriz-color">source</a>
        <span>100% client-side</span>
      </Fragment>
    </OzToolShell>
  </body>
</html>
